# ==========================================================
# KHCWW Welfare Management System - PHP/MariaDB backend
# Same-folder cPanel deployment (frontend + /api in public_html)
# ==========================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=https://welafarewebsit.neibasconsortium.co.ke/api

# ---- Database (cPanel MariaDB / phpMyAdmin) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=neibasco_welfare data
DB_USER=neibasco_Deno
DB_PASSWORD=Deno@26###
DB_CHARSET=utf8mb4

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_ISSUER=khcww-welfare
JWT_TTL=3600
REFRESH_TTL=2592000
DEFAULT_MEMBER_PASSWORD=Member2026

# ---- CORS (same origin, so just the site domain) ----
CORS_ORIGINS=https://welafarewebsit.neibasconsortium.co.ke

# ---- Storage ----
STORAGE_PATH=storage
STORAGE_PUBLIC_URL=https://welafarewebsit.neibasconsortium.co.ke/api/storage/v1/object
MAX_UPLOAD_MB=15

# ---- M-Pesa Daraja ----
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=testapi
MPESA_SECURITY_CREDENTIAL=
MPESA_CALLBACK_URL=https://welafarewebsit.neibasconsortium.co.ke/api/mpesa/callback

# ---- Talksasa SMS ----
TALKSASA_API_TOKEN=
TALKSASA_SENDER_ID=KHCWWELFARE
